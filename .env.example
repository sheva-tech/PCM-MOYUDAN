# Salin menjadi .env lalu isi. Jangan pernah commit .env
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Kosong -> SQLite. Isi URL PostgreSQL (Supabase/Neon) untuk produksi.
DATABASE_URL=

# Object storage S3-compatible untuk media di produksi (Supabase Storage). Kosongkan di laptop.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
# Hanya untuk Docker lokal: sajikan media dari Django saat DEBUG=False
SERVE_MEDIA=
# Hanya dibaca docker compose
POSTGRES_PASSWORD=
